{
  "tasks": {
    "dev": "deno -A jsr:@effection-contrib/watch deno run -A main.tsx --dev",
    "start": "deno -A main.tsx",
    "staticalize": "deno run -A jsr:@frontside/staticalize@^0.2.6/cli http://localhost:8005 --output=built --base=https://cogentdude.com --retries=0 && curl -s http://localhost:8005/sitemap.xml -o built/sitemap.xml && cp -R legacy/* built/ && cp CNAME built/",
    "test": "deno test -A test/",
    "check": "deno check main.tsx test/routes.test.ts"
  },
  "lint": {
    "rules": {
      "exclude": ["prefer-const", "require-yield", "jsx-no-useless-fragment", "no-import-prefix"]
    },
    "exclude": ["built"]
  },
  "fmt": {
    "exclude": ["built"]
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "revolution"
  },
  "imports": {
    "effection": "jsr:@effection/effection@3.6.1",
    "@astral/astral": "jsr:@astral/astral@^0.5.3",
    "hast": "npm:hast@^1.0.0",
    "hast-util-to-html": "npm:hast-util-to-html",
    "path-to-regexp": "npm:path-to-regexp@8.2.0",
    "revolution": "https://deno.land/x/revolution@0.6.1/mod.ts",
    "revolution/jsx-runtime": "https://deno.land/x/revolution@0.6.1/jsx-runtime.ts"
  }
}
